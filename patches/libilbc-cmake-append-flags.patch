Upstream's CMakeLists ASSIGNS the compiler flags rather than appending to them.

A bare set(CMAKE_C_FLAGS "...") replaces the value cmake initialises from the
CFLAGS environment variable, so mediaforge's composed flags never reach the
compile line: a --debug=full build produced "-Wall ... -fno-strict-aliasing -g
-fvisibility=hidden" and nothing of ours. The archive carried DWARF 2 from
cmake's own Debug -g instead of the -g3 the level asks for -- symbols without
macro definitions -- and its -O0 was the compiler default rather than anything
mediaforge chose.

Appending instead keeps upstream's warning set exactly as it was and lets the
environment's flags follow, where last-wins settles the optimization level.
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -53,7 +53,7 @@
 if((CMAKE_C_COMPILER_ID STREQUAL "GNU") OR
    (CMAKE_C_COMPILER_ID MATCHES "Clang" AND CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "GNU"))
-    set(CMAKE_C_FLAGS "-Wall -Wextra -Wmissing-prototypes -Wstrict-prototypes -Wno-unused-parameter -fno-strict-aliasing")
+    set(CMAKE_C_FLAGS "-Wall -Wextra -Wmissing-prototypes -Wstrict-prototypes -Wno-unused-parameter -fno-strict-aliasing ${CMAKE_C_FLAGS}")
     set(CMAKE_C_FLAGS_DEBUG "-g")
     set(CMAKE_C_FLAGS_RELEASE "-O2")
 endif()
 if((CMAKE_CXX_COMPILER_ID STREQUAL "GNU") OR
    (CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "GNU"))
-    set(CMAKE_CXX_FLAGS "-Wall -Wextra -Wno-unused-parameter -fno-strict-aliasing")
+    set(CMAKE_CXX_FLAGS "-Wall -Wextra -Wno-unused-parameter -fno-strict-aliasing ${CMAKE_CXX_FLAGS}")
     set(CMAKE_CXX_FLAGS_DEBUG "-g")
     set(CMAKE_CXX_FLAGS_RELEASE "-O2")
 endif()
